import os
from tinytroupe.environment.tiny_world import TinyWorld
from tinytroupe.factory.tiny_person_factory import TinyPersonFactory
from tinytroupe import control

# ==============================================================
# 🧹 Optional cache clearing
# ==============================================================

# Set RESET_CACHE=true in your terminal to clear caches before running.
if os.getenv("RESET_CACHE", "false").lower() == "true":
    for cache_file in ["user_feedback_simulation.cache.json", "openai_api_cache.pickle"]:
        if os.path.exists(cache_file):
            os.remove(cache_file)
            print(f"🧹 Cleared cache: {cache_file}")

# ==============================================================

print("\n🚀 Initializing User Feedback Simulation...\n")

# Begin recording (for checkpointing and restoration)
control.begin("user_feedback_simulation.cache.json")

print("\n🌍 Creating or restoring simulation world...\n")

# Create world
world = TinyWorld("User Feedback Simulation World")

print("\n👥 Generating user personas...\n")

# Create the factory for simulated users
factory = TinyPersonFactory(
    sampling_space_description="Users with diverse experiences testing a new app feature.",
    total_population_size=1,
    context="Simulating beta testers' first week with a new mobile productivity app."
)

# Generate personas (use generate_person for v0.5.2)
users = [
    factory.generate_person(),
    factory.generate_person(),
    factory.generate_person()
]

for user in users:
    print(f"✅ Created persona: {user.name}")

# Add users to the simulation world
for user in users:
    world.add_agent(user)


print("\n💾 Running simulation (phase 1)...\n")
world.run(3)

print("\n📍 Saving checkpoint...\n")
control.checkpoint()

print("\n💾 Running simulation (phase 2)...\n")
world.run(3)

print("\n🏁 Ending simulation and saving cache...\n")
control.end()

print("\n✅ Simulation complete. State saved to user_feedback_simulation.cache.json.\n")





